# Canonical deployment origin. Use HTTPS in production and no trailing path.
WERFT_APP_ORIGIN=http://localhost:3000

# GitHub App OAuth credentials. Configure the App itself with read-only repository permissions.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Base64url-encoded 32-byte key used only on the server to encrypt the HttpOnly session cookie.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WERFT_SESSION_SECRET=

# Login is configurable for a future rename; access is always bound to immutable owner id 46434977.
GITHUB_OWNER_LOGIN=Budladislav

# Optional subset of the fixed allowlist. Values outside it make configuration invalid.
GITHUB_REPOSITORIES=Flow,Planer,safe-play,fitness-tracker,ChronoAtlas
